# Bu dosyayı .env.docker adıyla kopyalayın ve token değerini değiştirin.
# Gerçek token içeren .env.docker dosyasını Git'e eklemeyin.
MAINTENANCE_TOKEN=replace-with-a-long-random-token
JWT_SECRET=replace-with-a-different-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=4320

# OAuth tamamlandığında dönülecek frontend origin'i
FRONTEND_URL=http://localhost:3000

# Local Docker varsayılanıdır. Railway'de PostgreSQL servisinin DATABASE_URL referansını kullanın.
DATABASE_URL=sqlite:////app/media/dublajlab.db

# Public demo güvenlik politikası. Canlı public demo öncesinde true yapın.
PUBLIC_DEMO_MODE=false
DEMO_MAX_FILE_SIZE_MB=20
DEMO_MAX_VIDEO_DURATION_SECONDS=30
DEMO_MAX_RECORDING_SIZE_MB=5
DEMO_MAX_EXPORTS_PER_IP_PER_DAY=5
DEMO_MEDIA_TTL_HOURS=24

# Yalnızca X-Forwarded-For değerini silip yeniden yazan güvenilir proxy arkasında true yapın.
TRUST_PROXY_HEADERS=false

# Deneysel lip-sync production'da varsayılan olarak kapalıdır.
# local sağlayıcı yalnız kişisel/akademik geliştirme ortamında kullanılabilir.
LIPSYNC_ENABLED=false
LIPSYNC_PROVIDER=disabled

# Object storage varsayılan olarak local volume kullanır. R2 değerlerini yalnız
# ayrı staging bucket smoke'u başarılı olduktan sonra provider dashboard'a girin.
STORAGE_PROVIDER=local
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=
S3_PUBLIC_BASE_URL=

# Tarayıcının erişebildiği backend adresi. Vite build sırasında bundle'a yazılır.
VITE_API_BASE_URL=http://localhost:8000
# Shopier'da oluşturduğunuz gerçek VIP ürün bağlantısı. Boşsa ödeme butonu güvenli biçimde pasif davranır.
VITE_SHOPIER_VIP_URL=
# Backend checkout endpoint'i yalnızca bu güvenli ürün URL'si ve Shopier secret'ları
# provider dashboard'da birlikte ayarlandığında ödeme kaydı oluşturur.
SHOPIER_PAYMENT_URL=
# Frontend'de gösterilen fiyat etiketi; ödeme doğrulamasında kaynak olarak Shopier siparişi esas alınır.
VITE_VIP_PRICE_LABEL=₺199

# İsteğe bağlı: varsayılan host portları. Port çakışmasında üçünü birlikte güncelleyin.
# BACKEND_PORT=8000
# FRONTEND_PORT=3000
# ALLOWED_ORIGINS=http://localhost:3000

VITE_SOCIAL_INSTAGRAM_URL=
VITE_SOCIAL_YOUTUBE_URL=
VITE_SOCIAL_TIKTOK_URL=
VITE_SOCIAL_X_URL=
VITE_SOCIAL_DISCORD_URL=
VITE_SOCIAL_LINKEDIN_URL=
