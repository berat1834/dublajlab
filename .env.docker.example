# Bu dosyayı .env.docker adıyla kopyalayın ve token değerini değiştirin.
# Gerçek token içeren .env.docker dosyasını Git'e eklemeyin.
MAINTENANCE_TOKEN=replace-with-a-long-random-token

# Tarayıcının erişebildiği backend adresi. Vite build sırasında bundle'a yazılır.
VITE_API_BASE_URL=http://localhost:8000

# İsteğe bağlı: varsayılan host portları. Port çakışmasında üçünü birlikte güncelleyin.
# BACKEND_PORT=8000
# FRONTEND_PORT=3000
# ALLOWED_ORIGINS=http://localhost:3000
