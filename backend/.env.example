# Virgülle ayrılmış frontend adresleri
ALLOWED_ORIGINS=http://localhost:5173

# development/dev/local/test ortamlarında boş bırakılabilir.
# Production ortamında güçlü ve rastgele bir değer kullanın.
APP_ENV=development
MAINTENANCE_TOKEN=

# İsteğe bağlı: FFmpeg araçları PATH'te değilse tam yolları girin
FFMPEG_BINARY=ffmpeg
FFPROBE_BINARY=ffprobe

# İsteğe bağlı: çalışma dosyaları için özel klasör
# MEDIA_ROOT=C:/temp/meme-dublaj-studio
