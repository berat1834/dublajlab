# Virgülle ayrılmış frontend adresleri
ALLOWED_ORIGINS=http://localhost:5173

# development/dev/local/test ortamlarında boş bırakılabilir.
# Production ortamında güçlü ve rastgele bir değer kullanın.
APP_ENV=development
MAINTENANCE_TOKEN=

# Public demo güvenlik politikası
PUBLIC_DEMO_MODE=false
DEMO_MAX_FILE_SIZE_MB=20
DEMO_MAX_VIDEO_DURATION_SECONDS=30
DEMO_MAX_RECORDING_SIZE_MB=5
DEMO_MAX_EXPORTS_PER_IP_PER_DAY=5
DEMO_MEDIA_TTL_HOURS=24

# Yalnızca güvenilir reverse proxy X-Forwarded-For değerini yönetiyorsa etkinleştirin.
TRUST_PROXY_HEADERS=false

# İsteğe bağlı: FFmpeg araçları PATH'te değilse tam yolları girin
FFMPEG_BINARY=ffmpeg
FFPROBE_BINARY=ffprobe

# İsteğe bağlı: çalışma dosyaları için özel klasör
# MEDIA_ROOT=C:/temp/meme-dublaj-studio
