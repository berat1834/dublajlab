# DublajLab Environment Variables

# Backend
ENVIRONMENT=development
# JWT secret for authentication. Must be a secure random string in production!
SECRET_KEY=demo-super-secret-key-12345
# Database URL. If not provided, defaults to local SQLite.
# For PostgreSQL use: postgresql://user:password@localhost:5432/dublajlab
DATABASE_URL=sqlite:///./data/dublajlab.db
# Redis Cache. Used for Rate Limits and Job Progress Persistence
REDIS_URL=redis://localhost:6379/0

# Password account email ownership verification. Production defaults to true.
# Keep SMTP secrets only in the provider dashboard, never in this file.
EMAIL_VERIFICATION_REQUIRED=false
EMAIL_VERIFICATION_TTL_MINUTES=60
PASSWORD_RESET_TTL_MINUTES=30
# Enable only after the API is served from a same-site HTTPS domain such as
# https://api.dublajlab.com.tr and OAuth callbacks have been updated.
AUTH_SESSION_COOKIE_ENABLED=false
AUTH_COOKIE_ONLY=false
# smtp veya resend. Railway Trial/Free/Hobby için resend kullanın.
EMAIL_DELIVERY_PROVIDER=smtp
RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESEND_REPLY_TO=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true
SMTP_USE_SSL=false
FRONTEND_URL=http://localhost:5173

# Lip-Sync Inference Engine
# disabled/local/modal/api; yalnız local geliştirme adaptörü hazırdır.
# Remote webhook değişkeni gelecek onaylı provider adaptörü için ayrılmıştır.
LIPSYNC_ENABLED=false
LIPSYNC_PROVIDER=disabled
LIPSYNC_WEBHOOK_URL=

# Frontend
VITE_API_BASE_URL=http://localhost:8000

# Shopier Webhook Secrets
SHOPIER_ENABLED=false
SHOPIER_API_KEY=your_shopier_api_key
SHOPIER_API_SECRET=your_shopier_api_secret
SHOPIER_PAYMENT_URL=
SHOPIER_CALLBACK_SECRET=your_shopier_callback_secret
SHOPIER_RETURN_URL=http://localhost:5173/membership/success
SHOPIER_CANCEL_URL=http://localhost:5173/membership

# Object storage (default local; use only a staging bucket first)
STORAGE_PROVIDER=local
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=
# Optional: leave empty to use one-hour presigned download URLs.
S3_PUBLIC_BASE_URL=

VITE_SOCIAL_INSTAGRAM_URL=
VITE_SOCIAL_YOUTUBE_URL=
VITE_SOCIAL_TIKTOK_URL=
VITE_SOCIAL_X_URL=
VITE_SOCIAL_DISCORD_URL=
VITE_SOCIAL_LINKEDIN_URL=
